{
  "name": "kabu-ai-world",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "KABU AI - Tigrinya-first child-friendly voice companion for Chrome",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite --host 127.0.0.1\"",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "node server.js",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.kabuai.world",
    "productName": "KABU AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "KABU-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}